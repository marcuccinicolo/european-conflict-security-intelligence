# Copy to .env (never commit .env). Only needed for the optional ACLED API fetch.
# Register at https://acleddata.com (myACLED account). ACLED's licence forbids
# redistributing raw data; fetched files land in data/raw/acled/ (git-ignored).
ACLED_USERNAME=your.registered.email@example.org
ACLED_PASSWORD=replace-with-your-password

# Optional: alternative database location
# ECSI_DB_PATH=data/processed/security.duckdb
